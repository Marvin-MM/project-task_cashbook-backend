# Test database — MUST be a throwaway. The harness truncates every table between tests.
# Create it once with:  createdb cashbook_test
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/cashbook_test

# The rest are only needed so config/index.ts validation passes; values are not used by tests.
JWT_SECRET=test-jwt-secret-value-at-least-32-characters-long
JWT_REFRESH_SECRET=test-refresh-secret-value-at-least-32-characters
