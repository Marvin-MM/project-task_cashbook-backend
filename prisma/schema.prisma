model InventoryStock {
  id               String  @id @default(uuid()) @db.Uuid
  itemId           String  @unique @map("item_id") @db.Uuid
  quantityOnHand   Int     @default(0) @map("quantity_on_hand")
  /// Units currently out on active rentals (not permanently sold).
  quantityRentedOut Int    @default(0) @map("quantity_rented_out")
  averageCost      Decimal @default(0) @map("average_cost") @db.Decimal(20, 4)

  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@map("inventory_stock")
}

model InventoryTransaction {
  id              String                   @id @default(uuid()) @db.Uuid
  workspaceId     String                   @map("workspace_id") @db.Uuid
  itemId          String                   @map("item_id") @db.Uuid
  transactionType InventoryTransactionType @map("transaction_type")
  quantity        Int
  unitCost        Decimal                  @map("unit_cost") @db.Decimal(20, 4)
  totalCost       Decimal                  @map("total_cost") @db.Decimal(20, 4)
  costOfGoodsSold Decimal?                 @map("cost_of_goods_sold") @db.Decimal(20, 4)
  sellingPrice    Decimal?                 @map("selling_price") @db.Decimal(20, 4)
  referenceType   InventoryReferenceType?  @map("reference_type")
  referenceId     String?                  @map("reference_id") @db.Uuid
  /// True for compensating rows written by reverseInventoryForReference.
  /// Reversal rows carry the SAME referenceType/referenceId as the movement they
  /// undo, so without this flag a second reversal re-reads them and undoes the
  /// undo — silently corrupting stock and average cost.
  isReversal      Boolean                  @default(false) @map("is_reversal")
  /// The movement this row reverses. Unique: a movement can be reversed once.
  reversesTransactionId String?            @unique @map("reverses_transaction_id") @db.Uuid
  notes           String?
  createdById     String                   @map("created_by_id") @db.Uuid
  createdAt       DateTime                 @default(now()) @map("created_at")

  item            InventoryItem         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  lotConsumptions LotConsumption[]
  reverses        InventoryTransaction? @relation("InventoryReversal", fields: [reversesTransactionId], references: [id])
  reversedBy      InventoryTransaction? @relation("InventoryReversal")

  @@index([itemId])
  @@index([workspaceId])
  @@index([referenceType, referenceId])
  @@index([referenceType, referenceId, isReversal])
  @@index([transactionType])
  @@index([createdAt])
  @@map("inventory_transactions")
}

// ─── Lot-based costing (FIFO / LIFO) ─────────────────────

model InventoryLot {
  id                String   @id @default(uuid()) @db.Uuid
  workspaceId       String   @map("workspace_id") @db.Uuid
  itemId            String   @map("item_id") @db.Uuid
  unitCost          Decimal  @map("unit_cost") @db.Decimal(20, 4)
  quantityIn        Int      @map("quantity_in")
  quantityRemaining Int      @map("quantity_remaining")
  transactionId     String   @map("transaction_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  item         InventoryItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  consumptions LotConsumption[]

  @@index([itemId, quantityRemaining])
  @@index([workspaceId])
  @@index([createdAt])
  @@map("inventory_lots")
}

// Links a stock-out transaction to the lot(s) it consumed.
model LotConsumption {
  id            String  @id @default(uuid()) @db.Uuid
  lotId         String  @map("lot_id") @db.Uuid
  transactionId String  @map("transaction_id") @db.Uuid
  quantityUsed  Int     @map("quantity_used")
  unitCost      Decimal @map("unit_cost") @db.Decimal(20, 4)

  lot         InventoryLot         @relation(fields: [lotId], references: [id], onDelete: Cascade)
