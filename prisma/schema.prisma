// ─── Accounts Subsystem ─────────────────────────────────

model AccountType {
  id             String                @id @default(uuid()) @db.Uuid
  workspaceId    String                @map("workspace_id") @db.Uuid
  name           String
  classification AccountClassification
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  accounts  Account[]

  @@unique([name, workspaceId])
  @@map("account_types")
}

model Account {
  id               String    @id @default(uuid()) @db.Uuid
  workspaceId      String    @map("workspace_id") @db.Uuid
  accountTypeId    String    @map("account_type_id") @db.Uuid
  name             String
  currency         String
  balance          Decimal   @default(0) @db.Decimal(20, 4)
  icon             String?
  excludeFromTotal Boolean   @default(false) @map("exclude_from_total")
  allowNegative    Boolean   @default(false) @map("allow_negative")
  note             String?
  archivedAt       DateTime? @map("archived_at")
  /// This wallet's ledger account. Nullable only to allow a non-destructive
  /// introduction of the ledger; every account created after Phase 1 has one.
  ledgerAccountId  String?   @unique @map("ledger_account_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  workspace       Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  accountType     AccountType          @relation(fields: [accountTypeId], references: [id])
  ledgerAccount   LedgerAccount?       @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)
  transactions    AccountTransaction[]
  expenseClaims   TaskExpenseClaim[]
  transfersFrom   AccountTransfer[]    @relation("TransferFrom")
  transfersTo     AccountTransfer[]    @relation("TransferTo")

  @@index([workspaceId])
  @@index([accountTypeId])
  @@index([archivedAt])
  @@map("accounts")
}

model AccountCategory {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace    Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions AccountTransaction[]

  @@unique([name, workspaceId])
  @@map("account_categories")
}

model AccountTransaction {
  id                String                @id @default(uuid()) @db.Uuid
  workspaceId       String                @map("workspace_id") @db.Uuid
  accountId         String                @map("account_id") @db.Uuid
  sourceType        TransactionSourceType @map("source_type")
  sourceId          String?               @map("source_id") @db.Uuid
  type              EntryType // income / expense
  amount            Decimal               @db.Decimal(20, 4)
  chargeAmount      Decimal?              @map("charge_amount") @db.Decimal(20, 4)
  description       String
  accountCategoryId String?               @map("account_category_id") @db.Uuid
  /// Business date of the movement. For cashbook-linked rows this mirrors
  /// Entry.entryDate, so a backdated entry lands in the wallet statement on the
  /// date it happened rather than at wall-clock insert time. Period filtering
  /// and statement ordering must use this, never createdAt.
  transactionDate   DateTime              @default(now()) @map("transaction_date")
  /// Bumped on each edit so the journal can be reversed and re-posted under a
  /// fresh posting key. Only meaningful for DIRECT rows.
  version           Int                   @default(1)
  /// When set, this row is retained for audit but must not affect wallet balance.
  voidedAt          DateTime?             @map("voided_at")
  createdAt         DateTime              @default(now()) @map("created_at")

  account         Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  sourceEntry     Entry?           @relation(fields: [sourceId], references: [id]) // Assuming CASHBOOK_ENTRY
  accountCategory AccountCategory? @relation(fields: [accountCategoryId], references: [id], onDelete: SetNull)

  @@unique([sourceId, accountId])
  @@index([accountId])
  @@index([sourceId])
  @@index([workspaceId])
  @@index([voidedAt])
  @@index([accountId, transactionDate])
  @@map("account_transactions")
}

// ─── Wallet transfers (not income/expense) ─────────────

model AccountTransfer {
  id            String    @id @default(uuid()) @db.Uuid
  workspaceId   String    @map("workspace_id") @db.Uuid
