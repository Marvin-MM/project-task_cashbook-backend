  currency               String                  @default("UGX")
  commercialMode         InventoryCommercialMode @default(SELL_ONLY) @map("commercial_mode")
  /// Default list / sell price per unit (money-in prefill, not COGS).
  defaultSellingPrice    Decimal?                @map("default_selling_price") @db.Decimal(20, 4)
  defaultRentalRate      Decimal?                @map("default_rental_rate") @db.Decimal(20, 4)
  defaultRentalPeriodUnit RentalPeriodUnit?      @map("default_rental_period_unit")
  lowStockThreshold      Int?                    @map("low_stock_threshold")
  costMethod             InventoryCostMethod     @default(WEIGHTED_AVERAGE) @map("cost_method")
  allowNegativeStock     Boolean                 @default(false) @map("allow_negative_stock")
  isActive               Boolean                 @default(true) @map("is_active")
