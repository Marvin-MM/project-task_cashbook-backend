model InventoryRentalLine {
  id             String           @id @default(uuid()) @db.Uuid
  rentalId       String           @map("rental_id") @db.Uuid
  inventoryItemId String          @map("inventory_item_id") @db.Uuid
  quantity       Int
  unitRate       Decimal          @map("unit_rate") @db.Decimal(20, 4)
  periodUnit     RentalPeriodUnit @map("period_unit")
  periodCount    Int              @default(1) @map("period_count")
  lineTotal      Decimal          @map("line_total") @db.Decimal(20, 4)
